<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>{45E097FC-297F-40FA-93BF-84B36D95269A}</ProjectGuid>
    <RootNamespace>IndicatorsPlusPlus</RootNamespace>
    <AssemblyName>Indicators++</AssemblyName>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Vendor DLLs. Defaults to the Tiger.com Windows install used by 7.4. -->
    <TigerTradeLib Condition="'$(TigerTradeLib)' == ''">C:\Program Files (x86)\TigerTrade</TigerTradeLib>
    <!--
      Tiger.com 7.4.9805 hosts net10.0 plus Microsoft.WindowsDesktop.App.
      That is the default. IncludeNet472=true also builds the previous
      net472 output, which only compiles against .NET Framework vendor DLLs.
      The 7.4 net10 vendor assemblies fail that target with CS1705.
    -->
    <TargetFramework Condition="'$(IncludeNet472)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFrameworks Condition="'$(IncludeNet472)' == 'true'">net10.0-windows;net472</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TigerTrade.Chart">
      <HintPath>$(TigerTradeLib)/TigerTrade.Chart.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TigerTrade.Core">
      <HintPath>$(TigerTradeLib)/TigerTrade.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TigerTrade.Dx">
      <HintPath>$(TigerTradeLib)/TigerTrade.Dx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TigerTrade.Tc">
      <HintPath>$(TigerTradeLib)/TigerTrade.Tc.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <Import Project="..\Common\Common.projitems" Label="Shared" />

  <!-- Copies the plugin on Windows. Remote and artifact builds set SkipPluginInstall=true. -->
  <Target Name="InstallPlugin" AfterTargets="Build" Condition="'$(SkipPluginInstall)' != 'true' AND '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -ExecutionPolicy Unrestricted -File &quot;$(SolutionDir)Scripts\post_build.ps1&quot; -BasePath &quot;$(SolutionDir)&quot; -SourcePath &quot;$(TargetPath)&quot; -TargetPathName INDICATORS_TARGET_PATH" />
  </Target>
</Project>
